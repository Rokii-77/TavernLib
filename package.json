{
  "name": "tavern-lib",
  "version": "1.0.0",
  "private": true,
  "description": "洛书匣 · 酒馆角色卡/世界书/预设/美化主题的本地资料库管理器",
  "author": "Roki",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "electron .",
    "start": "electron .",
    "preview": "vite preview --port 4180",
    "pack:dir": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.tavern.lib",
    "productName": "洛书匣",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "TavernLib",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TavernLib-Setup-${version}.exe"
    }
  }
}